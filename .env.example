# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Every var here is server-only: read it in route handlers or server actions, never from a
# client component. Only NEXT_PUBLIC_* may cross that boundary.

# Pooled Neon connection (host contains "-pooler"). Used by the app at runtime.
# Direct connections are capped by Postgres max_connections (104 on a 0.25 CU compute);
# the pooler handles far more, which is what serverless concurrency needs.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct Neon connection (same host without "-pooler"). Used by drizzle-kit only.
# PgBouncer's transaction mode doesn't support SET/RESET, PREPARE or temp tables, so DDL
# goes around the pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Groq API key for the agent's tool-calling loop. Free key from console.groq.com.
GROQ_API_KEY=""

# The Telegram user ID the web chatbox acts as, until the Login Widget is built.
# Any integer. The chat route refuses to run without it rather than inventing an identity.
DEV_TELEGRAM_USER_ID=""

# Telegram bot, from @BotFather. Server-only.
TELEGRAM_BOT_TOKEN=""

# Any A-Za-z0-9_- string, 1-256 chars. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call.
# Generate with: openssl rand -hex 32
# NOT `openssl rand -base64` — that emits + / = which Telegram rejects.
TELEGRAM_WEBHOOK_SECRET=""

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Public by design: the Login Widget script needs the bot's @username in the browser.
# A username, not a credential.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

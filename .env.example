# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Every var here is server-only: read it in route handlers or server actions, never from a
# client component. Only NEXT_PUBLIC_* may cross that boundary.

# Neon Postgres. Used by the app at runtime and by drizzle-kit for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Not read by any code yet — these arrive with the agent and Telegram features.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""
# ANTHROPIC_API_KEY=""
